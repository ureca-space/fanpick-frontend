{
  "name": "fanpick",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:kbo": "node --env-file=.env.sync scripts/sync-kbo-schedule.mjs",
    "sync:kbo:standings": "node --env-file=.env.sync scripts/sync-kbo-standings.mjs",
    "sync:kleague": "node --env-file=.env.sync scripts/sync-kleague-schedule.mjs",
    "sync:kleague:standings": "node --env-file=.env.sync scripts/sync-kleague-standings.mjs",
    "sync:lck": "node --env-file=.env.sync scripts/sync-lck-schedule.mjs",
    "sync:lck:standings": "node --env-file=.env.sync scripts/sync-lck-standings.mjs",
    "sync:prediction-results": "node --env-file=.env.sync scripts/sync-prediction-results.mjs",
    "sync:schedules": "npm run sync:kbo && npm run sync:kleague && npm run sync:lck",
    "sync:results": "npm run sync:schedules && npm run sync:prediction-results",
    "sync:standings": "npm run sync:kbo:standings && npm run sync:kleague:standings && npm run sync:lck:standings"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.1.1"
  }
}
